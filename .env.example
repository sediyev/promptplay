PORT=3000
# MODEL=claude-haiku-4-5
# PUBLIC_URL=https://promptplay.example.com   # used in invite QR codes; defaults to the request host
# SESSION_GRACE_MS=900000                     # room closes this long after the teacher dashboard disconnects
# Video call (see README "Video call"): without a TURN relay, people on mobile data or strict networks join but cannot see or hear anyone.
# Easiest: a free Cloudflare TURN key (dashboard: Realtime > TURN Server)
# CLOUDFLARE_TURN_KEY_ID=
# CLOUDFLARE_TURN_API_TOKEN=
# Or your own coturn:
# STUN_URLS=stun:stun.l.google.com:19302
# TURN_URLS=turn:turn.example.com:3478
# TURN_SECRET=the-same-value-as-coturn-static-auth-secret
# CALL_MAX=4
