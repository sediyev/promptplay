{
  "name": "promptplay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Classroom app where kids learn prompting and build games with Claude, under teacher supervision",
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js",
    "dev": "node --watch --env-file-if-exists=.env server/index.js",
    "test": "node --test",
    "home:sync": "node scripts/sync-home.mjs",
    "library:docs": "node scripts/sync-library-docs.mjs",
    "backup": "node --env-file-if-exists=.env scripts/backup.mjs"
  },
  "engines": {
    "node": ">=22.5"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "express": "^5.0.0",
    "qrcode": "^1.5.4"
  }
}
